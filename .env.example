# ============================================================================
#  ONE PIECE — Variables d'environnement
#  Copiez ce fichier en « .env » et renseignez vos valeurs Supabase.
#  Où les trouver : Supabase → votre projet → Project Settings → API.
#  ⚠️ Le fichier .env ne doit JAMAIS être commité (déjà ignoré par git).
# ============================================================================

# URL du projet (ex. https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=

# Clé « anon public » — destinée au navigateur, elle peut être publique.
# La sécurité repose sur les règles RLS (voir supabase/schema.sql).
VITE_SUPABASE_ANON_KEY=
